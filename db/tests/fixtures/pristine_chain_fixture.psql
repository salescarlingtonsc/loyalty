-- Shared rollback-only seed for legacy suites executed against a pristine final chain.
-- The including suite owns BEGIN/ROLLBACK. Nothing in this file commits.
do $pristine_chain_fixture$
declare
  v_owner_a uuid := gen_random_uuid();
  v_owner_b uuid := gen_random_uuid();
  v_owner_a_email text := 'pristine-owner-a-'||v_owner_a::text||'@example.test';
  v_owner_b_email text := 'pristine-owner-b-'||v_owner_b::text||'@example.test';
  v_business_a uuid;
  v_business_b uuid;
  v_client_a uuid;
  v_client_b uuid;
  v_draft uuid;
  v_application uuid;
  v_token text;
  v_sector text;
  v_result jsonb;
begin
  reset role;
  insert into auth.users(
    instance_id,id,aud,role,email,encrypted_password,email_confirmed_at,created_at,updated_at
  ) values
    ('00000000-0000-0000-0000-000000000000',v_owner_a,'authenticated','authenticated',
     v_owner_a_email,'',now(),now(),now()),
    ('00000000-0000-0000-0000-000000000000',v_owner_b,'authenticated','authenticated',
     v_owner_b_email,'',now(),now(),now());
  insert into public.super_admins(user_id,email,note)
  values(v_owner_b,v_owner_b_email,'rollback-only approval fixture');
  select sector_key into v_sector
  from public.sector_bundle_versions
  where status='published' and modules @> array[
    'dashboard','clients','sales','loyalty','packages','retention','appointments'
  ]::text[]
  order by sector_key
  limit 1;
  if v_sector is null then
    raise exception 'pristine fixture requires a published full-service sector';
  end if;

  -- Seed both legacy-suite tenants through the current approval-first contract.
  perform set_config('request.jwt.claim.sub','',true);
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub',null,'role','service_role')::text,true
  );
  execute 'set local role service_role';
  v_result:=public.internal_submit_business_application_v95(
    'Pristine Owner A',v_owner_a_email,'+6590000101',
    'Pristine chain fixture A',v_sector,null,'en',gen_random_uuid()
  );
  v_application:=(v_result->>'application_id')::uuid;
  reset role;
  perform set_config('request.jwt.claim.sub',v_owner_b::text,true);
  perform set_config('request.jwt.claims',json_build_object(
    'sub',v_owner_b,'role','authenticated'
  )::text,true);
  execute 'set local role authenticated';
  v_result:=public.platform_decide_business_application_v95(
    v_application,'approved','rollback fixture approval',1
  );
  v_token:=v_result->>'invitation_token';
  reset role;
  perform set_config('request.jwt.claim.sub',v_owner_a::text,true);
  perform set_config('request.jwt.claims',json_build_object(
    'sub',v_owner_a,'role','authenticated'
  )::text,true);
  execute 'set local role authenticated';
  v_result:=public.activate_approved_business_application_v95(
    v_token,'pristine-a-'||replace(v_owner_a::text,'-',''),gen_random_uuid()
  );
  v_business_a:=(v_result->>'business_id')::uuid;
  reset role;

  perform set_config('request.jwt.claim.sub','',true);
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub',null,'role','service_role')::text,true
  );
  execute 'set local role service_role';
  v_result:=public.internal_submit_business_application_v95(
    'Pristine Owner B',v_owner_b_email,'+6590000102',
    'Pristine chain fixture B',v_sector,null,'en',gen_random_uuid()
  );
  v_application:=(v_result->>'application_id')::uuid;
  reset role;
  perform set_config('request.jwt.claim.sub',v_owner_b::text,true);
  perform set_config('request.jwt.claims',json_build_object(
    'sub',v_owner_b,'role','authenticated'
  )::text,true);
  execute 'set local role authenticated';
  v_result:=public.platform_decide_business_application_v95(
    v_application,'approved','rollback fixture approval',1
  );
  v_token:=v_result->>'invitation_token';
  v_result:=public.activate_approved_business_application_v95(
    v_token,'pristine-b-'||replace(v_owner_b::text,'-',''),gen_random_uuid()
  );
  v_business_b:=(v_result->>'business_id')::uuid;
  reset role;

  reset role;
  update public.businesses set created_at='2000-01-01 00:00:00+00' where id=v_business_a;
  update public.businesses set created_at='2000-01-02 00:00:00+00' where id=v_business_b;
  update public.staff set created_at='2000-01-01 00:00:00+00' where business_id=v_business_a;
  update public.staff set created_at='2000-01-02 00:00:00+00' where business_id=v_business_b;

  insert into public.clients(business_id,full_name,email,phone) values
    (v_business_a,'Pristine customer A','pristine-a@example.test','+6590000001'),
    (v_business_b,'Pristine customer B','pristine-b@example.test','+6590000002');
  select id into v_client_a from public.clients
   where business_id=v_business_a and email='pristine-a@example.test';
  select id into v_client_b from public.clients
   where business_id=v_business_b and email='pristine-b@example.test';

  -- v480: this rollback fixture deliberately combines sale seeds and a later
  -- semantic loyalty publish in one transaction. Real requests do not. Take
  -- the exclusive per-business fence first so the fixture follows the only
  -- deadlock-safe ordering; all later shared value writes are satisfied by it.
  perform app.acquire_loyalty_exclusive_v480(v_business_a);
  perform app.acquire_loyalty_exclusive_v480(v_business_b);

  insert into public.sales(business_id,client_id,kind,amount_cents,occurred_at,note)
  values
    (v_business_a,v_client_a,'quick_sale',100,statement_timestamp(),'pristine RLS control A'),
    (v_business_b,v_client_b,'quick_sale',100,statement_timestamp(),'pristine RLS control B');

  -- The first tenant is the deterministic active-loyalty fixture selected by the
  -- legacy v26-v41 suites. Build it only through the current owner APIs.
  perform set_config('request.jwt.claim.sub',v_owner_a::text,true);
  perform set_config('request.jwt.claims',json_build_object(
    'sub',v_owner_a,'role','authenticated'
  )::text,true);
  v_draft := (public.create_loyalty_config_draft(
    v_business_a,null,'pristine-final-chain'
  )::jsonb->>'version_id')::uuid;
  perform public.save_loyalty_config_draft(v_draft,jsonb_build_object(
    'active',true,
    'kind','points',
    'loyalty_model','classic',
    'earn_points_per_dollar',1,
    'redeem_points',50,
    'reward_credit_cents',500,
    'expiry_mode','none'
  ),null);
  perform public.publish_loyalty_config(v_draft);
  perform public.set_programmes_v314(
    v_business_a,
    jsonb_build_object('points',true,'stamps',false,'tiers',false),
    gen_random_uuid()
  );

  reset role;
  perform set_config('request.jwt.claim.sub','',true);
  perform set_config('request.jwt.claims','{}',true);
end
$pristine_chain_fixture$;
