{
  "name": "nestly-static-production-baseline",
  "version": "0.0.0",
  "private": true,
  "description": "Production-readiness checks for the Peekaa business and customer app.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "quality": "node scripts/quality/static-baseline.mjs",
    "runtime-config:check": "node scripts/runtime-config/generate.mjs --config config/runtime/production.json --check",
    "migration-manifest:check": "node scripts/migrations/generate-manifest.mjs --check",
    "canonical-migrations:plan:check": "node scripts/migrations/materialize-canonical-order.mjs --check-plan",
    "canonical-migrations:materialize": "node scripts/migrations/materialize-canonical-order.mjs --materialize",
    "canonical-migrations:check": "node scripts/migrations/materialize-canonical-order.mjs --check",
    "mobile:prepare": "node scripts/mobile/prepare-web.mjs",
    "mobile:sync": "npm run mobile:prepare && cap sync",
    "mobile:store:validate": "node scripts/mobile/store-readiness.mjs",
    "mobile:store:associations": "node scripts/mobile/store-readiness.mjs --generate",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "dev:bootstrap-superadmin": "node scripts/dev/bootstrap-test-superadmin.mjs",
    "stripe:v124:setup": "node scripts/stripe/setup-v124-catalog.mjs",
    "test": "node --test",
    "test:db": "node scripts/db-tests/run.mjs",
    "test:db:snapshot": "node scripts/db-tests/snapshot-schema.mjs",
    "test:browser": "node scripts/quality/run-browser-checks.mjs",
    "build": "node scripts/quality/build-static.mjs",
    "validate": "npm run quality && npm run bundle-stamp:check && npm run runtime-config:check && npm run migration-manifest:check && npm run canonical-migrations:check && npm test && npm run build",
    "bundle-stamp": "node scripts/quality/stamp-app-bundle.mjs --write",
    "bundle-stamp:check": "node scripts/quality/stamp-app-bundle.mjs --check",
    "workspace-copy": "node scripts/quality/generate-workspace-copy-v97.mjs --write",
    "workspace-copy:check": "node scripts/quality/generate-workspace-copy-v97.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/network": "8.0.0",
    "@capacitor/share": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
